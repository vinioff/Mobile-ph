{
  "expo": {
    "name": "Nani Visuais",
    "slug": "nani-visuais-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nanivisuais",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.nanivisuais.app" },
    "android": { "package": "com.nanivisuais.app", "permissions": ["android.permission.CAMERA"] },
    "plugins": ["expo-router", "expo-camera", "expo-video"],
    "experiments": { "typedRoutes": true }
  }
}
